{
  "expo": {
    "name": "WORKOUTAPP",
    "slug": "WORKOUTAPP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Details.jpg",
    "scheme": "workoutapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Details.jpg"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
